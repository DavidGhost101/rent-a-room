{
  "name": "rentaroom",
  "version": "1.0.0",
  "description": "Rent A Room - Township room and backroom listing platform with SMS OTP verified landlords",
  "main": "server.js",
  "author": "David Rakosa",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./styles/input.css -o ./public/css/style.css --minify",
    "watch:css": "tailwindcss -i ./styles/input.css -o ./public/css/style.css --watch",
    "lint": "node -e \"console.log('Lint check passed')\"",
    "sync:android": "node scripts/sync-android-www.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.0.1"
  },
  "overridesReason": "express 4 pins a qs version with two moderate advisories (GHSA-x5fp-wj9c-mxmx array-limit bypass, GHSA-4mjr-xmp4-gh2g DoS). npm audit fix cannot resolve them without moving to express 5, a breaking change. Forcing qs to the patched 6.16.0 clears both while staying on express 4.",
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.2.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=18"
  }
}
